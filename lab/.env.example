# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit it, never paste these values into a chat,
# a screenshot or a commit message.
#
# Where each value comes from: see README.md, "One-time setup".
#   Tenant ID / Client ID -> app registration Overview page
#   Client secret         -> Certificates & secrets (shown once, at creation)

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
